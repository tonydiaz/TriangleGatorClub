<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <span>{{ site.brand_prefix }}</span>
      <span class="brand--accent">{{ site.brand_highlight }}</span>
      <span>{{ site.brand_suffix }}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {% for link in site.nav_links %}
      <a href="{{ link.url }}">{{ link.label }}</a>
      {% endfor %}
    </nav>
    <a class="btn btn--primary btn--small" href="{{ site.nav_button_url }}">{{ site.nav_button_text }}</a>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="site-nav site-nav--mobile" aria-label="Primary mobile">
    {% for link in site.nav_links %}
    <a href="{{ link.url }}">{{ link.label }}</a>
    {% endfor %}
    <a class="btn btn--primary btn--small" href="{{ site.nav_button_url }}">{{ site.nav_button_text }}</a>
  </nav>
</header>
