{% from "partials/icons.njk" import calendarIcon, clockIcon, pinIcon, commentIcon, giftIcon, contactIcon %}
{# Expects: event (a collection item), button_text #}
<div class="timeline-item" id="event-{{ event.fileSlug }}" data-tab="{{ event.data.tab }}" data-start="{{ event.data.event_start | isoDateTime }}">
  <span class="timeline-dot"></span>
  <article class="timeline-card">
    <div class="timeline-card__date">
      <span class="timeline-card__month">{{ event.data.event_start | monthShort }}</span>
      <span class="timeline-card__day">{{ event.data.event_start | dayNum }}</span>
    </div>
    <div class="timeline-card__body">
      {% if event.data.sponsor_logo %}
      {% if event.data.sponsor_website_url %}
      <a class="sponsor-badge" href="{{ event.data.sponsor_website_url }}" target="_blank" rel="noopener">
      {% else %}
      <div class="sponsor-badge">
      {% endif %}
        <span class="sponsor-badge__label">Sponsored by</span>
        <img src="{{ event.data.sponsor_logo }}" alt="{{ event.data.sponsor_name or 'Event sponsor' }} logo" loading="lazy">
      {% if event.data.sponsor_website_url %}
      </a>
      {% else %}
      </div>
      {% endif %}
      {% endif %}
      <div class="timeline-card__tags">
        <span class="tag-text">{{ event.data.category }}</span>
        {% if event.data.opponent_line %}<span class="tag-text tag-text--muted">{{ event.data.opponent_line }}</span>{% endif %}
      </div>
      <h3>{{ event.data.title }}</h3>
      <div class="timeline-card__desc">{{ event.templateContent | safe }}</div>
      <div class="timeline-card__meta">
        <span>{{ clockIcon() }}{{ event.data.event_start | dayTimeLabel }}</span>
        <span>{{ pinIcon() }}{% if event.data.location_url %}<a class="timeline-card__map-link" href="{{ event.data.location_url }}" target="_blank" rel="noopener">{{ event.data.location }}</a>{% else %}{{ event.data.location }}{% endif %}</span>
        {% if event.data.contact %}<span>{{ contactIcon() }}{{ event.data.contact }}</span>{% endif %}
      </div>
      <div class="timeline-card__actions">
        {% if event.data.calendar_url %}
        <a class="pill-btn pill-btn--solid" href="{{ event.data.calendar_url }}">{{ calendarIcon() }}Add to Calendar</a>
        {% endif %}
        {% if event.data.sponsor_available and event.data.sponsor_url and not event.data.sponsor_logo %}
        <a class="pill-btn pill-btn--outline-orange" href="{{ event.data.sponsor_url }}">{{ giftIcon() }}{{ button_text }}</a>
        {% endif %}
      </div>
    </div>
  </article>
</div>
