{# Expects: event (a collection item), mode ("home" or "sponsor"), button_text #}
<article class="event-card" data-tab="{{ event.data.tab }}">
  <div class="event-card__date">
    <span class="event-card__month">{{ event.data.event_start | monthShort }}</span>
    <span class="event-card__day">{{ event.data.event_start | dayNum }}</span>
  </div>
  <div class="event-card__body">
    <div class="event-card__tags">
      <span class="tag">{{ event.data.category }}</span>
      {% if event.data.opponent_line %}<span class="tag tag--muted">{{ event.data.opponent_line }}</span>{% endif %}
    </div>
    <h3>{{ event.data.title }}</h3>
    <div class="event-card__desc">{{ event.templateContent | safe }}</div>
    <p class="event-card__meta">{{ event.data.event_start | dayTimeLabel }}<br>{{ event.data.location }}</p>
    <div class="event-card__actions">
      {% if mode == "sponsor" %}
        {% if event.data.sponsor_url %}<a class="link-arrow" href="{{ event.data.sponsor_url }}">{{ button_text }}</a>{% endif %}
      {% else %}
        {% if event.data.calendar_url %}<a class="link-arrow" href="{{ event.data.calendar_url }}">Add to Calendar</a>{% endif %}
        {% if event.data.sponsor_available and event.data.sponsor_url %}
        <a class="link-arrow" href="{{ event.data.sponsor_url }}">{{ button_text }}</a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</article>
