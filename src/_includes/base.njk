<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.brand_prefix }} {{ site.brand_highlight }} {{ site.brand_suffix }}</title>
  <meta name="description" content="{{ description or 'The Florida Gators club for Raleigh, Durham and the surrounding areas.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  {% include "partials/nav.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "partials/marquee.njk" %}
  {% include "partials/footer.njk" %}
  <script src="/js/main.js"></script>
</body>
</html>
